# Validate the complete architecture contract before producing an installable WIM.
if(VENERA_TARGET_ARCH STREQUAL "x64")
  set(VENERA_INF_ARCH amd64)
  set(VENERA_PE_MACHINE 8664)
elseif(VENERA_TARGET_ARCH STREQUAL "arm64")
  set(VENERA_INF_ARCH arm64)
  set(VENERA_PE_MACHINE aa64)
else()
  message(FATAL_ERROR "Driver packages require VENERA_TARGET_ARCH=x64 or arm64")
endif()

function(venera_configure_inf source output)
  file(READ "${source}" inf)
  string(CONFIGURE "${inf}" inf @ONLY)
  set(${output} "${inf}" PARENT_SCOPE)
endfunction()

function(venera_check_pe file expected)
  file(SIZE "${file}" size)
  if(size LESS 64)
    message(FATAL_ERROR "${file}: truncated PE DOS header")
  endif()
  file(READ "${file}" dos LIMIT 64 HEX)
  string(SUBSTRING "${dos}" 0 4 magic)
  if(NOT magic STREQUAL "4d5a")
    message(FATAL_ERROR "${file}: missing PE DOS signature")
  endif()
  # e_lfanew, the little-endian PE header offset at DOS header byte 60.
  string(SUBSTRING "${dos}" 120 2 b0)
  string(SUBSTRING "${dos}" 122 2 b1)
  string(SUBSTRING "${dos}" 124 2 b2)
  string(SUBSTRING "${dos}" 126 2 b3)
  math(EXPR offset "0x${b3}${b2}${b1}${b0}")
  math(EXPR end "${offset} + 6")
  if(offset LESS 64 OR end GREATER size)
    message(FATAL_ERROR "${file}: invalid PE header offset")
  endif()
  file(READ "${file}" pe OFFSET ${offset} LIMIT 6 HEX)
  string(SUBSTRING "${pe}" 0 8 signature)
  if(NOT signature STREQUAL "50450000")
    message(FATAL_ERROR "${file}: missing PE signature")
  endif()
  string(SUBSTRING "${pe}" 8 2 lo)
  string(SUBSTRING "${pe}" 10 2 hi)
  if(NOT "${hi}${lo}" STREQUAL "${expected}")
    message(FATAL_ERROR "${file}: PE machine ${hi}${lo}, expected ${expected} for this package")
  endif()
endfunction()

function(venera_validate_payload)
  foreach(f IN LISTS ARGN)
    get_filename_component(name "${f}" NAME)
    if(name MATCHES "\\.(dll|exe|sys|com)$")
      if(name MATCHES "_32\\.dll$")
        venera_check_pe("${f}" 014c)
      else()
        venera_check_pe("${f}" "${VENERA_PE_MACHINE}")
      endif()
    endif()
  endforeach()
endfunction()
